# Copy to .env and fill in. Load it with Node's own flag, no dependency needed:
#
#   node --env-file=.env build.js
#   node --env-file=.env serve.js
#
# .env is gitignored. This repository is public, so a key committed here is a
# key you have to rotate. Nothing in this file should ever hold a real value.

# ─── the database ────────────────────────────────────────────────────────────
# Supabase → Settings → API. Both of these are safe in a browser: the anon key
# is designed to be public and row level security is what protects the data.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...

# Bypasses row level security completely. Netlify Functions only — never in a
# page, never in the repository, never pasted into a chat.
SUPABASE_SERVICE_KEY=eyJ...

# ─── order email ─────────────────────────────────────────────────────────────
# resend.com. Unset is fine: the function logs what it would have sent and marks
# the order as not notified rather than failing the order.
RESEND_API_KEY=re_...
MAIL_FROM=orders@klovrprecision.com
ORDER_NOTIFY_TO=shop@klovrprecision.com
MAIL_REPLY_TO=

# ─── QuickBooks ──────────────────────────────────────────────────────────────
# Not connected yet. QB_ENV is 'sandbox' or 'production'.
QB_CLIENT_ID=
QB_CLIENT_SECRET=
QB_REDIRECT_URI=
QB_STATE_SECRET=
QB_ENV=sandbox

# ─── switches ────────────────────────────────────────────────────────────────
# ANALYTICS=off turns first-party event collection off even with a database.
ANALYTICS=
# Set to 1 only when the policy pages have been reviewed and every blank filled.
POLICIES_FINAL=
# Lets /admin trigger a rebuild. Netlify → Build & deploy → Build hooks.
NETLIFY_BUILD_HOOK=
